{
  "sourceLocale": "en-GB",
  "targetLocales": [
    "de",
    "fr",
    "es",
    "pt-BR",
    "hi",
    "zh-Hans"
  ],
  "concurrency": 4,
  "batchConcurrency": 4,
  "batchSize": 20,
  "fileConcurrency": 2,
  "uiBatchConcurrency": 4,
  "maxBatchChars": 4096,
  "provider": "openrouter",
  "providers": {
    "openrouter": {
      "translationModels": [
        "qwen/qwen3.7-max",
        "~anthropic/claude-sonnet-latest",
        "openai/gpt-5.4",
        "google/gemini-3.5-flash",
        "tencent/hy-mt2-30b-a3b",
        "mistralai/mistral-large",
        "cohere/command-r-plus-08-2024",
        "openai/gpt-4o-mini",
        "qwen/qwen-2.5-72b-instruct"
      ],
      "uiModels": [
        "qwen/qwen3.7-max",
        "~anthropic/claude-sonnet-latest"
      ],
      "maxTokens": 8192,
      "temperature": 0.2,
      "requestTimeout": 240
    }
  },
  "features": {
    "translateUIStrings": true,
    "translateSVG": true,
    "translateDocs": true,
    "translateJson": true
  },
  "cacheDir": ".translation-cache",
  "glossary": {
    "uiGlossary": "src/locales/strings.json",
    "userGlossary": "glossary-user.csv"
  },
  "ui": {
    "sourceRoots": [
      "src/"
    ],
    "stringsJson": "src/locales/strings.json",
    "flatOutputDir": "src/locales/"
  },
  "svg": {
    "sourcePath": [
      "documentation/static/assets/duplistatus_dash-cards.svg",
      "documentation/static/assets/duplistatus_toolbar.svg"
    ],
    "outputDir": "documentation/i18n",
    "style": "nested",
    "pathTemplate": "{outputDir}/{locale}/docusaurus-plugin-content-docs/current/assets/{basename}",
    "forceLowercase": true
  },
  "docs": [
    {
      "description": "Docusaurus docs site",
      "contentPaths": [
        "documentation/docs"
      ],
      "outputDir": "documentation/i18n",
      "addFrontmatter": false,
      "docusaurusCatalogDir": "documentation/i18n/en-GB",
      "docsOutput": {
        "style": "docusaurus",
        "docsRoot": "documentation/docs"
      }
    }
  ],
  "json": [
    {
      "description": "Default notification templates",
      "contentPaths": "src/locales/templates/en-GB.json",
      "outputPathTemplate": "src/locales/templates/{locale}.json",
      "keyPolicy": {
        "mode": "denylist",
        "skipKeys": [
          "priority",
          "tags"
        ],
        "translateKeys": []
      }
    }
  ],
  "languagesManifestPath": "src/locales/ui-languages.json"
}
