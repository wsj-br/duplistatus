{
  "name": "duplistatus",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=10.24.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "./scripts/pre-checks.sh && NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "lint": "pnpm exec eslint .",
    "typecheck": "tsc --noEmit",
    "start": "NODE_ENV=production HOSTNAME=0.0.0.0 PORT=9666 NEXT_TELEMETRY_DISABLED=1 node --require ./scripts/peer-ip.cjs .next/standalone/server.js",
    "cron:start": "tsx src/cron-service/index.ts",
    "dev": "./scripts/pre-checks.sh && NODE_ENV=development PORT=8666 NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS='--require=./scripts/dev-preload.cjs' next dev",
    "cron:dev": "CRON_PORT=8667 tsx watch src/cron-service/index.ts",
    "build-local": "./scripts/pre-checks.sh && NEXT_TELEMETRY_DISABLED=1 next build --webpack && ./scripts/pos-build.sh",
    "start-local": "./scripts/pre-checks.sh && NODE_ENV=production HOSTNAME=0.0.0.0 PORT=8666 CRON_PORT=8667 NEXT_TELEMETRY_DISABLED=1 node --require ./scripts/peer-ip.cjs .next/standalone/server.js",
    "cron:start-local": "NODE_ENV=production CRON_PORT=8667 tsx watch src/cron-service/index.ts",
    "generate-test-data": "tsx scripts/generate-test-data.ts",
    "validate-csv-export": "tsx scripts/validate-csv-export.ts",
    "validate-daily-summary": "tsx scripts/validate-daily-summary.ts",
    "take-screenshots": "sh -c 'tsx --env-file=.env scripts/take-screenshots.ts \"$@\" 2>&1 | tee take-screenshots.log' _",
    "docker:up": "./scripts/pre-checks.sh && docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:clean": "./scripts/clean-docker.sh",
    "docker:devel": "docker build . -t wsj-br/duplistatus:devel",
    "docker:logs": "docker logs duplistatus",
    "docker:shell": "docker exec -it duplistatus /bin/sh",
    "test-entrypoint": "./scripts/test-entrypoint.sh",
    "i18n:extract": "ai-i18n-tools extract",
    "i18n:sync": "ai-i18n-tools sync",
    "i18n:translate": "ai-i18n-tools translate-ui && ai-i18n-tools translate-svg && ai-i18n-tools translate-docs",
    "i18n:translate:ui": "ai-i18n-tools translate-ui",
    "i18n:translate:svg": "ai-i18n-tools translate-svg",
    "i18n:translate:docs": "ai-i18n-tools translate-docs",
    "i18n:status": "ai-i18n-tools status",
    "i18n:editor": "ai-i18n-tools editor",
    "i18n:glossary-generate": "ai-i18n-tools glossary-generate -o documentation/glossary-user.csv",
    "i18n:generate-ui-languages": "ai-i18n-tools generate-ui-languages",
    "take-screenshots:install": "playwright install chromium",
    "notices:write": "node scripts/write-third-party-notices.js"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "ai-i18n-tools": "^1.8.4",
    "autoprefixer": "^10.5.4",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "html-to-text": "^10.0.1",
    "i18next": "^26.4.2",
    "juice": "^12.1.2",
    "lucide-react": "^1.40.0",
    "markdown-it": "^15.0.1",
    "next": "16.3.4",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.1.1",
    "postcss": "^8.5.28",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-datepicker": "^9.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^17.0.13",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.17.7",
    "serialize-javascript": "^7.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/html-to-text": "^9.0.4",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.4.1",
    "@types/node-cron": "^3.0.11",
    "@types/react": "19.2.18",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/parser": "^8.69.0",
    "baseline-browser-mapping": "latest",
    "eslint": "^10.9.1",
    "eslint-config-next": "16.3.4",
    "express": "5.2.1",
    "playwright": "^1.62.1",
    "semver": "^7.8.5",
    "tsx": "^4.23.13",
    "webpack": "^5.110.3"
  }
}
